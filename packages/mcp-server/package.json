{
  "name": "@contextos/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for ContextOS \u2014 provides dev ticket context to AI coding assistants",
  "type": "module",
  "bin": {
    "contextos-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.34"
    }
  }
}
