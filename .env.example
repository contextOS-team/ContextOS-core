# ===========================================
# ContextOS Environment Variables (Development)
# ===========================================
# After editing, run `make setup-frontend-env` to regenerate apps/web/.env.local

# ── Environment ──────────────────────────────────
ENVIRONMENT=dev

# ── URLs ─────────────────────────────────────────
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ── Database (async PostgreSQL for SQLAlchemy) ───
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# ── Supabase ─────────────────────────────────────
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── AI / LLM ────────────────────────────────────
# Required for synthesis, structured extraction, reranking, and embeddings.
GEMINI_API_KEY=
# Retained for legacy/optional OpenAI-backed experiments; not used by the core pipeline.
OPENAI_API_KEY=

# ── Supabase Auth Providers (Google & GitHub login) ──
# These are used by Supabase Auth for social login (NOT the GitHub App integration).
# Callback URL for both: http://localhost:54321/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── OAuth (DEV apps — localhost callbacks) ───────
# Create separate OAuth apps for local dev in each provider's dashboard.
# Use callback URL: http://localhost:8000/api/{provider}/callback
# Keep development credentials separate from production credentials.

# Linear (Settings > API > OAuth Apps)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Slack (api.slack.com > Your Apps)
# NOTE: Slack requires HTTPS redirect URIs even in dev.
# Set SLACK_REDIRECT_URI below to an HTTPS callback URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# GitHub App (Developer Settings > GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Notion (notion.so/profile/integrations)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_WEBHOOK_SECRET=

# GitLab (gitlab.com/-/user_settings/applications)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_WEBHOOK_SECRET=

# Jira (developer.atlassian.com/console/myapps)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_WEBHOOK_SECRET=

# Dedicated OAuth state signing secret (generate a random value for development)
OAUTH_STATE_SECRET=

# ── HTTPS Overrides (Slack & Telegram need HTTPS in dev) ──
# Slack OAuth requires HTTPS redirect URI — set to ngrok URL
SLACK_REDIRECT_URI=
# Optional static ngrok domain used by `make dev`
NGROK_DOMAIN=
# Telegram webhooks require a public HTTPS URL
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN_GLOBAL=
TELEGRAM_BOT_USERNAME=

# ── Fathom (meeting transcription) ───────────────
# Users provide their own Fathom API key in the integrations page.
# Only the base URL is needed here (default is usually fine).
FATHOM_API_BASE_URL=https://api.fathom.ai/external/v1

# ── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Observability ────────────────────────────────
LAMINAR_API_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# ── Telegram (critical error alerts) ─────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
