# ===========================================
# ContextOS Environment Variables
# ===========================================
# After editing, run `make setup-frontend-env` to regenerate apps/web/.env.local

# Environment
ENVIRONMENT=dev

# Database (async PostgreSQL connection string for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# OpenAI (embeddings + LLM synthesis)
OPENAI_API_KEY=

# Linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# GitHub App (create at GitHub.com -> Settings -> Developer settings -> GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# PEM file contents from GitHub App -> Generate a private key
GITHUB_APP_PRIVATE_KEY=

# Notion (https://www.notion.so/my-integrations -> Create public integration -> Distribution tab)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Verification token from Notion webhook subscription setup
NOTION_WEBHOOK_SECRET=

# Fathom
FATHOM_API_KEY=
FATHOM_API_BASE_URL=https://api.fathom.ai/external/v1

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Laminar (LLM observability -- https://laminar.sh)
LAMINAR_API_KEY=

# Sentry (error tracking -- get DSN from Sentry Dashboard -> Settings -> Client Keys)
SENTRY_DSN=

# Telegram (critical error alerts -- Sentry webhook posts to Telegram bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS
CORS_ORIGINS=http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000

# App URL (used by frontend for auth redirects)
APP_URL=http://localhost:3000

# ngrok (required for OAuth callbacks and webhooks in local dev)
# When set, OAuth redirect URIs auto-derive as https://{NGROK_DOMAIN}/api/{provider}/callback
# Get a free static domain at https://dashboard.ngrok.com/domains
NGROK_DOMAIN=your-subdomain.ngrok-free.dev
