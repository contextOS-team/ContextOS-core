# ===========================================
# ContextOS Environment Variables
# ===========================================

# Environment
ENVIRONMENT=dev

# Database (async PostgreSQL connection string for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Supabase (frontend -- NEXT_PUBLIC_ prefix exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (backend -- service role, never expose to browser)
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Gemini
GOOGLE_GENAI_API_KEY=

# Linear
LINEAR_API_KEY=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Laminar (LLM observability -- https://laminar.sh)
LAMINAR_API_KEY=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# CORS
CORS_ORIGINS=http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
