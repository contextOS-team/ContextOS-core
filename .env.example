# ===========================================
# ContextOS Environment Variables (Development)
# ===========================================
# After editing, run `make setup-frontend-env` to regenerate apps/web/.env.local

# ── Environment ──────────────────────────────────
ENVIRONMENT=dev

# ── URLs ─────────────────────────────────────────
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ── Database (async PostgreSQL for SQLAlchemy) ───
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# ── Supabase ─────────────────────────────────────
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── AI / LLM ────────────────────────────────────
OPENAI_API_KEY=

# ── OAuth (DEV apps — localhost callbacks) ───────
# Create separate OAuth apps for local dev in each provider's dashboard.
# Use callback URL: http://localhost:8000/api/{provider}/callback
# See SERVER.md "Environment Separation" for details.

# Linear (Settings > API > OAuth Apps)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Slack (api.slack.com > Your Apps)
# NOTE: Slack requires HTTPS redirect URIs even in dev — needs ngrok.
# Set SLACK_REDIRECT_URI below to your ngrok callback URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# GitHub App (Developer Settings > GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Notion (notion.so/profile/integrations)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_WEBHOOK_SECRET=

# ── OAuth Redirect URI Overrides (optional) ──────
# By default, redirect URIs derive from BACKEND_URL:
#   http://localhost:8000/api/{provider}/callback
# Override per-provider when needed (e.g. Slack needs HTTPS via ngrok).
# LINEAR_REDIRECT_URI=
# GITHUB_REDIRECT_URI=
# NOTION_REDIRECT_URI=
SLACK_REDIRECT_URI=

# ── ngrok ────────────────────────────────────────
# Required for Slack OAuth (Slack mandates HTTPS redirect URIs).
# Required for webhook testing with ALL providers (webhooks need a public URL).
# NOT required for OAuth with Linear, GitHub, Notion (they accept http://localhost).
# Get a free static domain at https://dashboard.ngrok.com/domains
NGROK_DOMAIN=

# ── Fathom (meeting transcription) ───────────────
# Users provide their own Fathom API key in the integrations page.
# Only the base URL is needed here (default is usually fine).
FATHOM_API_BASE_URL=https://api.fathom.ai/external/v1

# ── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Observability ────────────────────────────────
LAMINAR_API_KEY=
SENTRY_DSN=

# ── Telegram (critical error alerts) ─────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
