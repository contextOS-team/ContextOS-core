# ===========================================
# ContextOS Environment Variables
# ===========================================

# Environment
ENVIRONMENT=dev

# Database (async PostgreSQL connection string for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Supabase (frontend -- NEXT_PUBLIC_ prefix exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (backend -- service role, never expose to browser)
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Gemini
GOOGLE_GENAI_API_KEY=

# Linear
LINEAR_API_KEY=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
# Default: {BACKEND_URL}/api/linear/callback (leave empty to use default)
LINEAR_REDIRECT_URI=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Default: {BACKEND_URL}/api/slack/callback (leave empty to use default)
SLACK_REDIRECT_URI=
SLACK_BOT_TOKEN=

# GitHub App (create at GitHub.com -> Settings -> Developer settings -> GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# PEM file contents from GitHub App -> Generate a private key
GITHUB_APP_PRIVATE_KEY=
# Default: {BACKEND_URL}/api/github/callback (leave empty to use default)
GITHUB_REDIRECT_URI=

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Laminar (LLM observability -- https://laminar.sh)
LAMINAR_API_KEY=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# CORS
CORS_ORIGINS=http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000

# Fathom
FATHOM_API_KEY=
FATHOM_API_BASE_URL=https://api.fathom.ai/external/v1

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
