# ===========================================
# ContextOS Backend Environment Variables
# ===========================================
# Copy to ../.env (project root) and fill in values.
# Settings are loaded from the root .env file.

# Environment
ENVIRONMENT=dev

# Database (async PostgreSQL connection string for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Gemini
GEMINI_API_KEY=

# Linear
LINEAR_API_KEY=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
LINEAR_REDIRECT_URI=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=
SLACK_BOT_TOKEN=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REDIRECT_URI=

# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
NOTION_WEBHOOK_SECRET=

# Fathom
FATHOM_API_KEY=
FATHOM_API_BASE_URL=https://api.fathom.ai/external/v1

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Laminar (LLM observability)
LAMINAR_API_KEY=

# Sentry (error tracking)
SENTRY_DSN=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000
