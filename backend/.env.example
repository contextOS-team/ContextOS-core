# ===========================================
# ContextOS Backend Environment Variables
# ===========================================
# Copy to ../.env (project root) and fill in values.
# Settings are loaded from the root .env file.

# Environment
ENVIRONMENT=dev

# Database (async PostgreSQL connection string for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Gemini
GOOGLE_GENAI_API_KEY=

# Linear
LINEAR_API_KEY=

# Slack
SLACK_BOT_TOKEN=

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Laminar (LLM observability)
LAMINAR_API_KEY=

# Sentry (error tracking)
SENTRY_DSN=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000
